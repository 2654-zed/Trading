# Copy this file to `.env` and paste the real secrets. `.env` is GITIGNORED —
# never commit it, never paste a real key into chat, code, a Dockerfile, or CI YAML.
# Each collaborator keeps their own local .env; share the actual values out-of-band
# (a shared password-manager vault), NOT through the repo. See docs/TARDIS.md.

# Tardis.dev API key. Used by the Python `tardis-dev` client AND by tardis-machine
# (docker compose maps it to TM_API_KEY). One key works on multiple machines.
TARDIS_DEV=

# bloXroute mempool capture auth header (only if running the on-chain capture).
# BLOXROUTE_AUTH_HEADER=

# Anthropic key for the research_loop live mode (optional).
# ANTHROPIC_API_KEY=
